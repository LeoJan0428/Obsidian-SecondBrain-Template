#!/bin/sh
# ==============================================================================
# 🛡️ SecondBrain Git Commit-Msg Sanitize & Format Hook
# ==============================================================================

COMMIT_MSG_FILE="$1"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

# 1. In-place strip AI watermarks & co-authored tags (preserving commit content)
sed -i -E '/^[[:space:]]*([Cc]o-[Aa]uthored-[Bb]y|[Ss]igned-[Oo]ff-[Bb]y|[Gg]enerated ([Bb]y|[Ww]ith)|[Aa][Ii]-[Gg]enerated|[Cc]laude [Cc]ode|[Cc]ursor)/d' "$COMMIT_MSG_FILE"

# 2. Extract first non-comment, non-empty line
FIRST_LINE=$(grep -v '^[[:space:]]*#' "$COMMIT_MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

if [ -z "$FIRST_LINE" ]; then
    echo "🛑 [GIT COMMIT-MSG ERROR] Commit message is empty!"
    exit 1
fi

# 3. Validate Conventional Commits format
CONVENTIONAL_PATTERN="^(feat|fix|docs|refactor|chore|test)(\([a-zA-Z0-9_-]+\))?: .+"

if ! echo "$FIRST_LINE" | grep -E -q "$CONVENTIONAL_PATTERN"; then
    echo "🛑 [GIT COMMIT-MSG ERROR] Invalid Commit Subject format!"
    echo "   Current        : $FIRST_LINE"
    echo ""
    echo "   Expected format: <type>(<scope>): <subject>"
    echo "   Allowed types  : feat | fix | docs | refactor | chore | test"
    echo "   Example        : feat(stock): 新增動態價格階梯"
    echo "   Example        : docs(agentos): 更新 CONTEXT.md 任務狀態"
    exit 1
fi

exit 0
